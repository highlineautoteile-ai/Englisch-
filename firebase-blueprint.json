{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about the user and their learning progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "completedLessons": { "type": "array", "items": { "type": "string" } },
        "totalPoints": { "type": "number" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "A specific management English lesson.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "difficulty": { "type": "string" }
      },
      "required": ["id", "title", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile and progress data."
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Available lessons in the app."
    }
  }
}
